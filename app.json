{
  "expo": {
    "name": "앱덱",
    "slug": "appdeck",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "appdeck",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.appdeck.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "앱덱",
        "CFBundleDevelopmentRegion": "ko",
        "NSPhotoLibraryUsageDescription": "주차 위치 메모에 사진을 첨부할 때 사용자가 고른 사진 한 장만 사용해요.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.appdeck.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_DELETE_PACKAGES",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9EDFB",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "주차 위치 메모에 사진을 첨부할 때 사용자가 고른 사진 한 장만 사용해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b650d068-301c-45f2-bf06-55d721c9de6b"
      }
    },
    "owner": "lcm2"
  }
}
